{
  "schema_version": "workflow_skill_v1",
  "name": "schedule_meeting",
  "type": "workflow",
  "description": "Find calendar context, resolve contacts, then prepare a confirmed calendar event creation step.",
  "permissions": [
    "tool:calendar_search",
    "tool:contacts_search",
    "tool:calendar_create"
  ],
  "steps": [
    {
      "id": "calendar_context",
      "tool": "calendar_search",
      "input": {
        "query": "{{ user.request }}",
        "limit": 10
      },
      "checkpoint": true
    },
    {
      "id": "contacts",
      "tool": "contacts_search",
      "input": {
        "query": "{{ user.request }}",
        "limit": 5
      },
      "checkpoint": true
    },
    {
      "id": "create_event",
      "tool": "calendar_create",
      "input": {
        "title": "{{ user.request }}",
        "start_time": "{{ user.request }}"
      },
      "confirmation": true,
      "idempotency": "required"
    }
  ]
}
