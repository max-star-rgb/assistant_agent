{
  "schema_version": "workflow_skill_v1",
  "name": "capture_action_items",
  "type": "workflow",
  "description": "Capture a concrete action item from the current conversation as a confirmed reminder.",
  "permissions": [
    "tool:reminder_create"
  ],
  "steps": [
    {
      "id": "create_reminder",
      "tool": "reminder_create",
      "input": {
        "title": "{{ user.request }}"
      },
      "confirmation": true,
      "idempotency": "required"
    }
  ]
}
