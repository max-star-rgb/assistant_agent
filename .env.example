# Phase 4.5 real Vision Provider smoke configuration.
# Copy variable names into your local shell or an untracked local env file.
# Do not put real API keys in this example file.

# Global provider mode. This is the only mock/real execution switch.
# In mock mode all provider-backed capabilities use mock implementations.
# In real mode the main LLM must be configured and tools never fall back to mock.
MULTIMODAL_AGENT_PROVIDER_MODE=mock

# Optional local-only debugging content for tool history and traces.
# Keep disabled for real mode; set to 1 only in an untracked mock-mode env.
MULTIMODAL_AGENT_LOCAL_TRACE_CONTENT=0
# Optional Mem0 change text in a loopback-only local Langfuse export. This
# remains disabled unless explicitly enabled and never enters canonical JSONL.
MULTIMODAL_AGENT_LOCAL_MEMORY_TRACE_CONTENT=0

# Optional local Langfuse stack. Host, OTLP path, Basic auth header, service name,
# timeout, queue capacities, and full local generation input use repository defaults.
LANGFUSE_PUBLIC_KEY=<set-in-local-shell>
LANGFUSE_SECRET_KEY=<set-in-local-shell>
ASSISTANT_AGENT_OTEL_EXPORT_ENABLED=false
ASSISTANT_AGENT_LANGFUSE_SCORE_ENABLED=false

# Optional signed Langfuse Remote Experiment trigger. Keep disabled until the
# Assistant Server is in real Provider mode and the signing secret shown by the
# Langfuse Custom Experiment setup has been copied into the local untracked env.
ASSISTANT_AGENT_LANGFUSE_REMOTE_EXPERIMENT_ENABLED=false
ASSISTANT_AGENT_LANGFUSE_REMOTE_EXPERIMENT_SIGNING_SECRET=<set-in-local-shell>
ASSISTANT_AGENT_LANGFUSE_REMOTE_EXPERIMENT_DATASET=assistant-agent-regression

# Optional Web Console trial allowlist.
# Leave empty for local open demo mode. Set one or more ids to restrict /demo/console users.
# Example: MULTIMODAL_AGENT_TRIAL_USER_IDS=alice,bob,phone-demo-01
MULTIMODAL_AGENT_TRIAL_USER_IDS=
# Optional text file, one id per line or comma separated. Keep real pilot lists untracked.
MULTIMODAL_AGENT_TRIAL_USER_ID_FILE=

# Image understanding selector. For realtime video, qwen selects only the dedicated
# Qwen realtime WebSocket adapter; uploaded videos stay mock unless a private HTTP
# video service is configured outside this example.
# Default remains mock. Set to openai, qwen, seed, or ark only when manually running smoke.
MULTIMODAL_AGENT_VISION_PROVIDER=mock

# OpenAI Vision Provider placeholders
OPENAI_API_KEY=<set-in-local-shell>
OPENAI_VISION_BASE_URL=<optional-openai-compatible-base-url-ending-with-v1>
OPENAI_VISION_MODEL=<optional-openai-vision-model>

# Qwen Vision Provider placeholders.
# Realtime video uses QWEN_REALTIME_VISION_* and prefers QWEN_VISION_API_KEY;
# it falls back to DASHSCOPE_API_KEY.
QWEN_VISION_API_KEY=<set-in-local-shell>
DASHSCOPE_API_KEY=<set-in-local-shell-fallback>
QWEN_VISION_BASE_URL=<optional-qwen-compatible-base-url-ending-with-v1>
QWEN_VISION_MODEL=<optional-qwen-vision-model>
QWEN_REALTIME_VISION_WORKSPACE_ID=<recommended-bailian-workspace-id-for-realtime>
QWEN_REALTIME_VISION_REGION=cn-beijing
QWEN_REALTIME_VISION_BASE_URL=<optional-explicit-realtime-websocket-overrides-workspace>
QWEN_REALTIME_VISION_MODEL=<optional-defaults-to-qwen3.5-omni-flash-realtime>

# Seed Vision Provider placeholders
SEED_API_KEY=<set-in-local-shell>
SEED_VISION_BASE_URL=<required-openai-compatible-base-url-ending-with-v1>
SEED_VISION_MODEL=<optional-seed-vision-model>

# Ark Vision Provider placeholders
ARK_VISION_API_KEY=<set-in-local-shell>
ARK_VISION_BASE_URL=<optional-ark-base-url-defaults-to-api-v3>
ARK_VISION_MODEL=<optional-ark-vision-model>

# Intent Router placeholder
# Default remains rule. mock_llm and hybrid are offline test modes; llm is a default-off skeleton.
MULTIMODAL_AGENT_INTENT_ROUTER=rule

# Chat Provider placeholders
# Default remains mock. Set to openai, qwen, deepseek, or local only when manually running smoke.
MULTIMODAL_AGENT_CHAT_PROVIDER=mock
QWEN_API_KEY=<set-in-local-shell>
QWEN_CHAT_BASE_URL=<optional-defaults-to-dashscope-openai-compatible-v1>
# The Bailian-compatible endpoint may host Qwen or supported third-party models.
QWEN_CHAT_MODEL=qwen-plus
DEEPSEEK_CHAT_API_KEY=<set-in-local-shell>
DEEPSEEK_CHAT_BASE_URL=<optional-deepseek-openai-compatible-base-url-ending-with-v1>
DEEPSEEK_CHAT_MODEL=<optional-deepseek-chat-model>
LOCAL_CHAT_BASE_URL=<optional-local-openai-compatible-chat-base-url>
# Bailian native search always uses SDK streaming; the native runtime consumer remains opt-in.
# DeepSeek also defaults its SDK stream on when selected, while runtime-native consumption remains opt-in.
CHAT_STREAM=true
MULTIMODAL_AGENT_NATIVE_PROVIDER_STREAMING=true
DEEPSEEK_CHAT_STREAM=true

# Optional rolling LLM context compaction. It is inactive in mock mode and
# never downloads tokenizer assets. Point the path at the tokenizer.json for
# the deployed chat model and keep the configured limit aligned with its endpoint.
MULTIMODAL_AGENT_CONTEXT_COMPACTOR=off
MULTIMODAL_AGENT_CONTEXT_TOKENIZER_PATH=<local-tokenizer-json-path>
MULTIMODAL_AGENT_CONTEXT_INPUT_TOKEN_LIMIT=128000
MULTIMODAL_AGENT_CONTEXT_COMPACTION_TARGET_RATIO=0.40
MULTIMODAL_AGENT_CONTEXT_COMPACTION_TRIGGER_RATIO=0.70
MULTIMODAL_AGENT_CONTEXT_COMPACTION_HARD_RATIO=0.85
MULTIMODAL_AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=50000
MULTIMODAL_AGENT_CONTEXT_SUMMARY_MAX_TOKENS=32768

# Optional trusted deployment location injected into the system prompt's
# "当前环境" section. It falls back to 上海 when unset; a user-specified target
# location always takes precedence.
MULTIMODAL_AGENT_CURRENT_LOCATION=<current-city-or-region>

# Real personal-assistant tools such as weather and email use explicitly mapped MCP servers.
# Copy deploy/mcp_servers.example.json to the ignored .local/mcp_servers.json, replace the
# Gmail account placeholder, and complete provider-side OAuth authentication.
# These settings are ignored in mock mode. Stable calendar tools use local SQLite.
MULTIMODAL_AGENT_MCP_ENABLED=0
MULTIMODAL_AGENT_MCP_CONFIG_PATH=.local/mcp_servers.json
# The AMap example uses npx and may download the pinned 0.0.8 package on first use.
# Replace its AMAP_MAPS_API_KEY placeholder only in the ignored local MCP config; never here.
# workspace-mcp reads these from the parent process. Keep real values in the local shell or
# an ignored .env file; the Gmail user email is configured separately in mcp_servers.json.
GOOGLE_OAUTH_CLIENT_ID=<set-in-local-shell>
GOOGLE_OAUTH_CLIENT_SECRET=<set-in-local-shell>
# Local stdio OAuth uses http://localhost:8000/oauth2callback. Never use this setting for a
# public/non-loopback deployment; configure HTTPS and an exact redirect URI there instead.
OAUTHLIB_INSECURE_TRANSPORT=1
WORKSPACE_MCP_PORT=8000

# Read-only hotel search with OTA handoff through the official FlyAI CLI.
# Requires real provider mode and an explicitly installed CLI executable.
MULTIMODAL_AGENT_LODGING_PROVIDER=mock
FLYAI_CLI_PATH=<absolute-path-to-flyai-cli>
FLYAI_API_KEY=<set-in-local-shell>
FLYAI_TIMEOUT_SECONDS=30

# Image Generation Provider placeholders
# Default remains mock. Set to openai, qwen, ark, comfyui, or local only when manually running smoke.
MULTIMODAL_AGENT_IMAGE_PROVIDER=mock
QWEN_IMAGE_API_KEY=<set-in-local-shell>
QWEN_IMAGE_BASE_URL=<optional-dashscope-image-base-url-defaults-to-api-v1>
QWEN_IMAGE_MODEL=<optional-qwen-image-model>
ARK_IMAGE_API_KEY=<set-in-local-shell>
ARK_IMAGE_BASE_URL=<required-ark-image-base-url>
ARK_IMAGE_MODEL=<required-ark-image-model>
COMFYUI_BASE_URL=<optional-local-comfyui-base-url>
LOCAL_IMAGE_BASE_URL=<optional-local-image-provider-base-url>
# Optional trusted LAN origin used to publish managed generated-image links.
ARTIFACT_BASE_URL=http://<LAN_AGENT_IP>:8089

# Unified real-only shopping_search provider placeholders.
# Mock mode does not register a shopping Tool. In real mode use http or haodanku.
MULTIMODAL_AGENT_SHOPPING_PROVIDER=mock
SHOPPING_SEARCH_BASE_URL=<optional-shopping-search-service-base-url>
SHOPPING_SEARCH_API_KEY=<set-in-local-shell>
SHOPPING_COMPARE_BASE_URL=<optional-shopping-compare-service-base-url>
SHOPPING_COMPARE_API_KEY=<set-in-local-shell>

# Haodanku(好单库) real keyword search / price-compare provider.
# Set MULTIMODAL_AGENT_SHOPPING_PROVIDER=haodanku to use Haodanku for shopping search and comparison.
# Requires MULTIMODAL_AGENT_PROVIDER_MODE=real.
HAODANKU_API_KEY=<set-in-local-shell>
HAODANKU_BASE_URL=<optional-defaults-to-https://v3.api.haodanku.com>

# Deprecated, unregistered web_search / web_fetch adapter settings. Runtime uses
# Bailian native turbo search and does not expose these local tools in mock or real mode.
MULTIMODAL_AGENT_SEARCH_PROVIDER=mock
TAVILY_API_KEY=<set-in-local-shell>
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT_SECONDS=10
HAODANKU_TIMEOUT_SECONDS=<optional-defaults-to-10>
# Comma-separated canonical names: taobao, jd, pdd. Defaults to taobao only.
HAODANKU_ENABLED_PLATFORMS=taobao
HAODANKU_TAOBAO_PID=<optional-required-for-taobao-official-link-conversion>
HAODANKU_TAOBAO_AUTHORIZED_NAME=<optional-required-for-taobao-official-link-conversion>
HAODANKU_JD_SUB_UNION_ID=<optional-jd-attribution-channel>
HAODANKU_PDD_CHANNEL=<optional-pdd-attribution-channel>

# Integration tests stay disabled by default.
RUN_INTEGRATION_TESTS=0
