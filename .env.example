# Phase 4.5 real Vision Provider smoke configuration.
# Copy variable names into your local shell or an untracked local env file.
# Do not put real API keys in this example file.

# Runtime profile
# Default remains local_demo. Use provider_smoke or pilot only with explicit local config.
# Real/network provider selectors are ignored unless this is provider_smoke or pilot.
MULTIMODAL_AGENT_RUNTIME_PROFILE=local_demo

# Optional Web Console trial allowlist.
# Leave empty for local open demo mode. Set one or more ids to restrict /demo/console users.
# Example: MULTIMODAL_AGENT_TRIAL_USER_IDS=alice,bob,phone-demo-01
MULTIMODAL_AGENT_TRIAL_USER_IDS=
# Optional text file, one id per line or comma separated. Keep real pilot lists untracked.
MULTIMODAL_AGENT_TRIAL_USER_ID_FILE=

# Image understanding selector. For realtime video, qwen selects only the dedicated
# Qwen realtime WebSocket adapter; uploaded videos stay mock unless a private HTTP
# video service is configured outside this example.
# Default remains mock. Set to openai, qwen, seed, or ark only when manually running smoke.
MULTIMODAL_AGENT_VISION_PROVIDER=mock

# OpenAI Vision Provider placeholders
OPENAI_API_KEY=<set-in-local-shell>
OPENAI_VISION_BASE_URL=<optional-openai-compatible-base-url-ending-with-v1>
OPENAI_VISION_MODEL=<optional-openai-vision-model>

# Qwen Vision Provider placeholders.
# Realtime video uses QWEN_REALTIME_VISION_* and prefers QWEN_VISION_API_KEY;
# it falls back to DASHSCOPE_API_KEY.
QWEN_VISION_API_KEY=<set-in-local-shell>
DASHSCOPE_API_KEY=<set-in-local-shell-fallback>
QWEN_VISION_BASE_URL=<optional-qwen-compatible-base-url-ending-with-v1>
QWEN_VISION_MODEL=<optional-qwen-vision-model>
QWEN_REALTIME_VISION_WORKSPACE_ID=<recommended-bailian-workspace-id-for-realtime>
QWEN_REALTIME_VISION_REGION=cn-beijing
QWEN_REALTIME_VISION_BASE_URL=<optional-explicit-realtime-websocket-overrides-workspace>
QWEN_REALTIME_VISION_MODEL=<optional-defaults-to-qwen3.5-omni-flash-realtime>

# Seed Vision Provider placeholders
SEED_API_KEY=<set-in-local-shell>
SEED_VISION_BASE_URL=<required-openai-compatible-base-url-ending-with-v1>
SEED_VISION_MODEL=<optional-seed-vision-model>

# Ark Vision Provider placeholders
ARK_VISION_API_KEY=<set-in-local-shell>
ARK_VISION_BASE_URL=<optional-ark-base-url-defaults-to-api-v3>
ARK_VISION_MODEL=<optional-ark-vision-model>

# Render Provider placeholders
# Default remains mock. Set to http only when manually testing a configured render service.
MULTIMODAL_AGENT_RENDER_PROVIDER=mock
RENDER_BASE_URL=<optional-render-provider-base-url>
RENDER_API_KEY=<set-in-local-shell>
RENDER_TIMEOUT_SECONDS=<optional-render-timeout-seconds>

# Intent Router placeholder
# Default remains rule. mock_llm and hybrid are offline test modes; llm is a default-off skeleton.
MULTIMODAL_AGENT_INTENT_ROUTER=rule

# Chat Provider placeholders
# Default remains mock. Set to openai, qwen, deepseek, or local only when manually running smoke.
MULTIMODAL_AGENT_CHAT_PROVIDER=mock
DEEPSEEK_CHAT_API_KEY=<set-in-local-shell>
DEEPSEEK_CHAT_BASE_URL=<optional-deepseek-openai-compatible-base-url-ending-with-v1>
DEEPSEEK_CHAT_MODEL=<optional-deepseek-chat-model>
LOCAL_CHAT_BASE_URL=<optional-local-openai-compatible-chat-base-url>
# Qwen defaults to native Provider token streaming; set both flags false to opt out.
# DeepSeek also defaults its SDK stream on when selected, while runtime-native consumption remains opt-in.
CHAT_STREAM=true
MULTIMODAL_AGENT_NATIVE_PROVIDER_STREAMING=true
DEEPSEEK_CHAT_STREAM=true

# Image Generation Provider placeholders
# Default remains mock. Set to openai, qwen, ark, comfyui, or local only when manually running smoke.
MULTIMODAL_AGENT_IMAGE_PROVIDER=mock
QWEN_IMAGE_API_KEY=<set-in-local-shell>
QWEN_IMAGE_BASE_URL=<optional-dashscope-image-base-url-defaults-to-api-v1>
QWEN_IMAGE_MODEL=<optional-qwen-image-model>
ARK_IMAGE_API_KEY=<set-in-local-shell>
ARK_IMAGE_BASE_URL=<required-ark-image-base-url>
ARK_IMAGE_MODEL=<required-ark-image-model>
COMFYUI_BASE_URL=<optional-local-comfyui-base-url>
LOCAL_IMAGE_BASE_URL=<optional-local-image-provider-base-url>

# Unified shopping_search provider placeholders
# Default remains mock. local_json is offline; http requires a private configured service. haodanku is a real provider.
MULTIMODAL_AGENT_SHOPPING_SEARCH_PROVIDER=mock
MULTIMODAL_AGENT_SHOPPING_COMPARE_PROVIDER=mock
SHOPPING_SEARCH_LOCAL_PATH=<optional-demo-data-products-json-path>
SHOPPING_SEARCH_BASE_URL=<optional-shopping-search-service-base-url>
SHOPPING_SEARCH_API_KEY=<set-in-local-shell>
SHOPPING_COMPARE_BASE_URL=<optional-shopping-compare-service-base-url>
SHOPPING_COMPARE_API_KEY=<set-in-local-shell>

# Haodanku(好单库) real keyword search / price-compare provider.
# Set MULTIMODAL_AGENT_SHOPPING_SEARCH_PROVIDER=haodanku and/or MULTIMODAL_AGENT_SHOPPING_COMPARE_PROVIDER=haodanku
# (requires provider_smoke or pilot runtime profile) to enable.
HAODANKU_API_KEY=<set-in-local-shell>
HAODANKU_BASE_URL=<optional-defaults-to-https://v3.api.haodanku.com>
HAODANKU_TIMEOUT_SECONDS=<optional-defaults-to-10>
# Comma-separated canonical names: taobao, jd, pdd. Defaults to taobao only.
HAODANKU_ENABLED_PLATFORMS=taobao
HAODANKU_TAOBAO_PID=<optional-required-for-taobao-official-link-conversion>
HAODANKU_TAOBAO_AUTHORIZED_NAME=<optional-required-for-taobao-official-link-conversion>
HAODANKU_JD_SUB_UNION_ID=<optional-jd-attribution-channel>
HAODANKU_PDD_CHANNEL=<optional-pdd-attribution-channel>

# Integration tests stay disabled by default.
RUN_INTEGRATION_TESTS=0
