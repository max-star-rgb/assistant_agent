# 本文件随 Git 分发；安装脚本仅在 .env 不存在时复制。
# 真实密钥只填写到未跟踪的 .env，不要把本文件改成真实配置。
# 默认 mock 可离线启动；启用 real 时同时配置主模型和所需 Provider。

# Global provider mode. This is the only mock/real execution switch.
# In mock mode all provider-backed capabilities use mock implementations.
# In real mode the main LLM must be configured and tools never fall back to mock.
MULTIMODAL_AGENT_PROVIDER_MODE=mock

# Agent Server's native LangChain/LangGraph callback tracing switch.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=assistant-agent-runtime
LANGSMITH_WORKSPACE_ID=
# LangSmith UI Model Configuration UUID used by Dataset evaluator automation.
LANGSMITH_EVALUATOR_MODEL_CONFIG_ID=

# Image understanding selector. Background keyframe windows use the selected image
# provider; qwen uses DashScope's native ordered multi-image API. Uploaded videos
# stay mock unless a private HTTP video service is configured outside this example.
# Default remains mock. Set to openai, qwen, seed, or ark only when manually running smoke.
MULTIMODAL_AGENT_VISION_PROVIDER=mock

# 安装阶段准备图文联合 ONNX；mock 模式不加载本地模型。
MULTIMODAL_AGENT_EMBEDDING_PROVIDER=local_siglip2
SIGLIP2_MODEL_DIR=data/models/siglip2-base-patch16-224
SIGLIP2_CUDA_DEVICE_ID=0

# OpenAI Vision Provider placeholders
OPENAI_API_KEY=
OPENAI_VISION_BASE_URL=
OPENAI_VISION_MODEL=

# Qwen Vision Provider placeholders. Background keyframe windows use these values
# and fall back to DASHSCOPE_API_KEY. A compatible-mode base URL is normalized to
# the native DashScope multimodal-generation endpoint on the same host.
QWEN_VISION_API_KEY=
DASHSCOPE_API_KEY=
QWEN_VISION_BASE_URL=
QWEN_VISION_MODEL=
QWEN_REALTIME_VISION_WORKSPACE_ID=
QWEN_REALTIME_VISION_REGION=cn-beijing
QWEN_REALTIME_VISION_BASE_URL=
QWEN_REALTIME_VISION_MODEL=

# BGE 视觉历史文本检索缓存；按安装说明下载，检索还需要 Qdrant。
# Local visual-text retrieval. Qdrant >=1.17 performs multilingual BM25 and
# Weighted RRF; FastEmbed loads BAAI/bge-small-zh-v1.5 from this prefilled
# local cache with local_files_only=True. Runtime startup never downloads it.
VISUAL_MEMORY_QDRANT_URL=http://127.0.0.1:6333
VISUAL_MEMORY_QDRANT_COLLECTION=assistant_visual_memory
VISUAL_MEMORY_QDRANT_TIMEOUT_SECONDS=2
VISUAL_MEMORY_DENSE_MODEL_CACHE_DIR=data/models/fastembed

# Seed Vision Provider placeholders
SEED_API_KEY=
SEED_VISION_BASE_URL=
SEED_VISION_MODEL=

# Ark Vision Provider placeholders
ARK_VISION_API_KEY=
ARK_VISION_BASE_URL=
ARK_VISION_MODEL=

# Chat Provider placeholders
# Default remains mock. Set to openai, qwen, deepseek, or local only when manually running smoke.
MULTIMODAL_AGENT_CHAT_PROVIDER=mock
QWEN_API_KEY=
QWEN_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen chat always uses the native DashScope API.
QWEN_CHAT_MODEL=qwen-plus
# Known models derive text or multimodal API mode from QWEN_CHAT_MODEL.
DEEPSEEK_CHAT_API_KEY=
DEEPSEEK_CHAT_BASE_URL=
DEEPSEEK_CHAT_MODEL=
LOCAL_CHAT_BASE_URL=
# DashScope-native chat uses incremental HTTP SSE when runtime-native streaming is enabled.
# DeepSeek also defaults its SDK stream on when selected; the shared runtime switch remains explicit.
CHAT_STREAM=true
MULTIMODAL_AGENT_NATIVE_PROVIDER_STREAMING=true
# Search uses the bailian_web_search MCP tool; model-native search stays off.
QWEN_CHAT_ENABLE_SEARCH=false
DEEPSEEK_CHAT_STREAM=true

# Optional rolling LLM context compaction. Known model IDs derive their context
# window and tokenizer automatically. This path is only an override for models
# that are not registered or for an explicitly provisioned tokenizer snapshot.
MULTIMODAL_AGENT_CONTEXT_COMPACTOR=off
# MULTIMODAL_AGENT_CONTEXT_TOKENIZER_PATH=
# MULTIMODAL_AGENT_CONTEXT_INPUT_TOKEN_LIMIT=
MULTIMODAL_AGENT_CONTEXT_COMPACTION_TARGET_RATIO=0.15
MULTIMODAL_AGENT_CONTEXT_COMPACTION_TRIGGER_RATIO=0.75
MULTIMODAL_AGENT_CONTEXT_COMPACTION_HARD_RATIO=0.85
MULTIMODAL_AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=50000
MULTIMODAL_AGENT_CONTEXT_SUMMARY_MAX_TOKENS=32768

# Long-term memory. Extraction runs as a separate Agent Server graph after
# this many seconds of inactivity on the conversation thread.
# Real deployments use mem0; keep disabled for mock/offline runs.
MEMORY_BACKEND=disabled
MEMORY_EXTRACTION_DELAY_SECONDS=1800
REMOTE_VISUAL_MEMORY_ENABLED=false
REMOTE_VISUAL_MEMORY_BASE_URL=http://127.0.0.1:5200
REMOTE_VISUAL_MEMORY_DOWNLOAD_BASE_URL=http://127.0.0.1:8089
REMOTE_VISUAL_MEMORY_QUERY_TIMEOUT_SECONDS=5
REMOTE_VISUAL_MEMORY_QUERY_TOP_K=8
REMOTE_VISUAL_MEMORY_SEGMENT_SECONDS=30
REMOTE_VISUAL_MEMORY_SPOOL_ROOT=data/remote_visual_memory
REMOTE_VISUAL_MEMORY_FILE_TTL_SECONDS=86400
REMOTE_VISUAL_MEMORY_POLL_INTERVAL_SECONDS=2
# LangMem 的旧部署配置已删除；默认使用 disabled，可显式选择 mem0。
LANGMEM_MODEL=
# text-embedding-v4, 1024 dimensions; credentials/endpoint fall back to QWEN_API_KEY/QWEN_CHAT_BASE_URL.
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_BASE_URL=
MEM0_BASE_URL=http://127.0.0.1:8890

# Trusted default location injected into the system prompt's user-characteristics
# section. A deployment-specific value may override it.
MULTIMODAL_AGENT_CURRENT_LOCATION=

# External tools such as Playwright, AMap and Gmail use the single MCPServerConfig schema.
# Copy config/mcp_servers.example.json to the ignored local/mcp_servers.json, replace only
# provider credentials/placeholders, and complete provider-side OAuth authentication.
# Install the pinned Gmail MCP executable ahead of server startup with
# `python -m pip install -e ".[google-workspace-mcp]"`; do not use uvx in the runtime config,
# because dependency resolution would block native Graph composition during cold start.
# MCP registration is controlled only by this explicit flag. Stable calendar tools use local
# SQLite; configured profiles are exposed only when matching tools were actually discovered.
MULTIMODAL_AGENT_MCP_ENABLED=0
MULTIMODAL_AGENT_MCP_CONFIG_PATH=local/mcp_servers.json
# 可选完整 MCP 模板 config/mcp_services.example.json 包含百炼搜索、高德、Gmail。
AMAP_MAPS_API_KEY=
# Client browser: assistant-agent --install-browser --cwd <cwd> (Node.js 20+).
# Studio uses its configured server-side Playwright. --extension is optional for an existing Chrome.
# Playwright and AMap may download pinned packages on first use.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
# Keep the ${AMAP_MAPS_API_KEY} reference in MCP JSON; set the real key only in ignored .env.
# workspace-mcp reads these from the parent process. Keep real values in the local shell or
# an ignored .env file; the selected Gmail account comes from provider OAuth, not project mapping.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local stdio OAuth uses http://localhost:8000/oauth2callback. Never use this setting for a
# public/non-loopback deployment; configure HTTPS and an exact redirect URI there instead.
OAUTHLIB_INSECURE_TRANSPORT=1
WORKSPACE_MCP_PORT=8000

# Read-only hotel search with OTA handoff through the official FlyAI CLI.
# Requires real provider mode and an explicitly installed CLI executable.
MULTIMODAL_AGENT_LODGING_PROVIDER=mock
FLYAI_CLI_PATH=
FLYAI_API_KEY=
FLYAI_TIMEOUT_SECONDS=30

# Durable hotel-price monitoring and Agent-Service proactive reminders.
# Keep disabled unless the operator explicitly wants background execution.
MULTIMODAL_AGENT_DURABLE_TASKS_ENABLED=false

# Explicit product publishers enqueue here; the Agent Server media custom route owns
# presence, WebSocket delivery, ACK, and same-thread reconnect handling.
PROACTIVE_DELIVERY_STORE_PATH=data/agent_server/proactive_deliveries.sqlite3
PROACTIVE_DELIVERY_ACK_TIMEOUT_SECONDS=15
PROACTIVE_DELIVERY_LEASE_SECONDS=30
PROACTIVE_DELIVERY_PRESENCE_TTL_SECONDS=45
PROACTIVE_DELIVERY_POLL_INTERVAL_SECONDS=0.25

# Image Generation Provider placeholders
# Default remains mock. Set to openai, qwen, ark, comfyui, or local only when manually running smoke.
MULTIMODAL_AGENT_IMAGE_PROVIDER=mock
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_BASE_URL=
QWEN_IMAGE_MODEL=
QWEN_IMAGE_DEFAULT_SIZE=
ARK_IMAGE_API_KEY=
ARK_IMAGE_BASE_URL=
ARK_IMAGE_MODEL=
COMFYUI_BASE_URL=
LOCAL_IMAGE_BASE_URL=
# Unified real-only shopping_search provider placeholders.
# Mock mode does not register a shopping Tool. In real mode use http or haodanku.
MULTIMODAL_AGENT_SHOPPING_PROVIDER=mock
SHOPPING_SEARCH_BASE_URL=
SHOPPING_SEARCH_API_KEY=
SHOPPING_COMPARE_BASE_URL=
SHOPPING_COMPARE_API_KEY=

# Haodanku(好单库) real keyword search / price-compare provider.
# Set MULTIMODAL_AGENT_SHOPPING_PROVIDER=haodanku to use Haodanku for shopping search and comparison.
# Requires MULTIMODAL_AGENT_PROVIDER_MODE=real.
HAODANKU_API_KEY=
HAODANKU_BASE_URL=

HAODANKU_TIMEOUT_SECONDS=
# Comma-separated canonical names: taobao, jd, pdd. Defaults to taobao only.
HAODANKU_ENABLED_PLATFORMS=taobao
HAODANKU_TAOBAO_PID=
HAODANKU_TAOBAO_AUTHORIZED_NAME=
HAODANKU_JD_SUB_UNION_ID=
HAODANKU_PDD_CHANNEL=

# Integration tests stay disabled by default.
RUN_INTEGRATION_TESTS=0
