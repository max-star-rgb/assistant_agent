{
  "servers": [
    {
      "server_name": "amap_maps",
      "transport": "stdio",
      "command": [
        "/usr/bin/npx",
        "-y",
        "@amap/amap-maps-mcp-server@0.0.8"
      ],
      "env": {
        "AMAP_MAPS_API_KEY": "<set-in-ignored-local-config>"
      },
      "allowed_tools": [
        "maps_geo",
        "maps_ip_location",
        "maps_bicycling",
        "maps_direction_walking",
        "maps_direction_driving",
        "maps_direction_transit_integrated",
        "maps_text_search",
        "maps_around_search"
      ],
      "read_only_tools": [
        "maps_geo",
        "maps_ip_location",
        "maps_bicycling",
        "maps_direction_walking",
        "maps_direction_driving",
        "maps_direction_transit_integrated",
        "maps_text_search",
        "maps_around_search"
      ],
      "timeout_seconds": 30
    },
    {
      "server_name": "google_gmail_readonly",
      "transport": "stdio",
      "command": [
        "/home/lenovo1/miniconda3/envs/hello_agent/bin/uvx",
        "--with",
        "PySocks",
        "--from",
        "workspace-mcp==1.22.0",
        "workspace-mcp",
        "--tools",
        "gmail",
        "--read-only"
      ],
      "allowed_tools": [
        "search_gmail_messages",
        "get_gmail_messages_content_batch"
      ],
      "read_only_tools": [
        "search_gmail_messages",
        "get_gmail_messages_content_batch"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "email_tools": {
        "search": "search_gmail_messages",
        "read_batch": "get_gmail_messages_content_batch",
        "profile": "workspace_mcp_v1",
        "user_email": "<your-google-account@example.com>"
      },
      "timeout_seconds": 20
    }
  ]
}
