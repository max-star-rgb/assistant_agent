{
  "schema_version": "assistant_agent_evaluator_manifest_v1",
  "dataset_rules": [
    "assistant-agent-infrastructure-v1",
    "assistant-agent-behavior-v2"
  ],
  "calibration_sets": [
    {
      "capability": "grounded_file_synthesis",
      "source": "evals/langfuse/evaluators/calibration/grounded_file_synthesis_v1.json",
      "status": "pending_ui_judge_validation"
    },
    {
      "capability": "clarification_before_write",
      "source": "evals/langfuse/evaluators/calibration/clarification_before_write_v1.json",
      "status": "pending_ui_judge_validation"
    }
  ],
  "evaluators": [
    {
      "id": "agent-strict-pass-v1",
      "version": "v1",
      "kind": "code",
      "source": "evals/langfuse/evaluators/agent_strict_pass.ts",
      "deployment": "langfuse_ui",
      "scores": [
        "agent.runtime_trace_pass",
        "agent.tool_mechanical_pass"
      ]
    },
    {
      "id": "assistant-agent-tool-semantic-pass-zh",
