      "source": "langfuse_ui",
      "deployment": "langfuse_ui",
      "connection": "deepseek-judge",
      "model_requirements": {
        "structured_output": true,
        "model_params": {
          "providerOptions": {
            "anthropic": {
              "thinking": {
                "type": "disabled"
              }
            }
          }
        }
      },
      "scores": ["agent.tool_semantic_pass"]
    },
    {
      "id": "assistant-agent-answer-semantic-pass-zh",
      "version": "ui-managed-v1",
      "kind": "llm_as_a_judge",
      "source": "langfuse_ui",
      "deployment": "langfuse_ui",
      "connection": "deepseek-judge",
      "model_requirements": {
        "structured_output": true,
        "model_params": {
          "providerOptions": {
            "anthropic": {
              "thinking": {
                "type": "disabled"
              }
            }
          }
        }
      },
      "scores": ["agent.answer_semantic_pass"]
    }
  ]
}
