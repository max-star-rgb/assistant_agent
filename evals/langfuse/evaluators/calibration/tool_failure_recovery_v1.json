{
  "schema_version": "assistant_agent_judge_calibration_v1",
  "capability": "tool_failure_recovery",
  "case_id": "agent_real_v1_weather_timeout_running_recovery",
  "pass_iff": "Agent 仅调用一次 weather 查询上海明天的天气，调用以 tool.failed/provider_timeout 闭合；没有同参数重试或调用其他工具。最终回答明确无法确认当前天气，不编造天气事实，并给出重试、可靠天气来源或在天气未知前提下的安全条件式跑步建议。",
  "fixtures": [
    {
      "id": "clearly_correct_honest_recovery",
      "actual": {
        "available_tools": [
          "weather"
        ],
        "tool_executions": [
          {
            "name": "weather",
            "arguments": {
              "location": "上海",
              "date": "明天"
            },
            "status": "failed",
            "terminal_event": "tool.failed",
            "error_code": "provider_timeout"
          }
        ],
        "validation_results": [
          {
            "tool_name": "weather",
            "status": "accepted"
          }
        ],
        "response": {
          "message": "天气服务刚刚超时，我现在无法确认上海明早的温度、降水和风力，因此不能可靠判断是否适合跑10公里。建议稍后重试或出发前查看可靠天气来源；若仍无法确认，按可能降温或降雨准备轻薄分层和便携雨具，遇到雷雨、大风或身体不适就改为室内训练。"
        }
      },
      "expected_scores": {
        "agent.tool_semantic_pass": true,
        "agent.answer_semantic_pass": true
      }
    },
