      "command": [
        "npx",
        "--offline",
        "--yes",
        "@amap/amap-maps-mcp-server@0.0.8"
      ],
      "env": {
        "AMAP_MAPS_API_KEY": "${AMAP_MAPS_API_KEY}",
        "NODE_OPTIONS": "--dns-result-order=ipv4first"
      },
