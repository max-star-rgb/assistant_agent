{
  "servers": [
    {
      "server_name": "bailian",
      "transport": "streamable_http",
      "url": "https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp",
      "bearer_token_env": "QWEN_API_KEY",
      "allowed_tools": ["bailian_web_search"],
      "general_purpose_tools": ["bailian_web_search"],
      "interrupt_tools": []
    },
    {
      "server_name": "playwright",
      "transport": "stdio",
      "session_scope": "thread",
      "command": [
        "/home/lenovo1/.nvm/versions/node/v24.16.0/bin/npx",
        "--yes",
        "@playwright/mcp@0.0.78",
        "--browser",
        "chromium",
        "--headless",
        "--output-dir",
        "{cwd}/.agent/browser"
      ],
      "cwd": "{cwd}",
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "${PLAYWRIGHT_BROWSERS_PATH}",
        "NODE_OPTIONS": "--dns-result-order=ipv4first",
        "PATH": "/home/lenovo1/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "allowed_tools": [
        "browser_close",
