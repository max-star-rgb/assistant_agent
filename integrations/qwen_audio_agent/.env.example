# 默认不会启动真实 Gateway；离线验证运行 npm test。
MULTIMODAL_AGENT_PROVIDER_MODE=mock
QWEN_AUDIO_ENABLE_REAL=0
DASHSCOPE_API_KEY=
QWEN_AUDIO_REALTIME_MODEL=qwen3.5-omni-flash-realtime
# 使用对应百炼业务空间的 WebSocket 地址
QWEN_AUDIO_REALTIME_BASE_URL=
QWEN_AUDIO_PORT=3101
ASSISTANT_AGENT_URL=http://127.0.0.1:8088
ASSISTANT_AGENT_USER=local-developer
# 可选绝对路径；默认 ~/.local/state/assistant_agent/qwen_audio
# QWEN_AUDIO_STATE_DIR=
