+++ b/langgraph_runtime_inmem/queue_signal.py
@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+import asyncio
+import threading
+
+
+def _resolve_waiter(waiter: asyncio.Future[None]) -> None:
+    if not waiter.done():
+        waiter.set_result(None)
+
+
+class RunQueueSignal:
+    """Thread-safe edge-triggered notification for the in-memory run queue."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._generation = 0
+        self._active_run_ids: set[object] = set()
+        self._waiters: set[
+            tuple[asyncio.AbstractEventLoop, asyncio.Future[None]]
+        ] = set()
+
+    def generation(self) -> int:
+        with self._lock:
+            return self._generation
+
+    def activate(self, run_id: object) -> None:
+        with self._lock:
+            self._active_run_ids.add(run_id)
+
+    def deactivate(self, run_id: object) -> None:
+        with self._lock:
+            self._active_run_ids.discard(run_id)
+
+    def is_active(self, run_id: object) -> bool:
+        with self._lock:
+            return run_id in self._active_run_ids
+
+    def notify(self) -> None:
+        with self._lock:
+            self._generation += 1
+            waiters = tuple(self._waiters)
+            self._waiters.clear()
+        for loop, waiter in waiters:
+            loop.call_soon_threadsafe(_resolve_waiter, waiter)
+
+    async def wait_for_change(self, generation: int, *, timeout: float) -> None:
+        loop = asyncio.get_running_loop()
+        waiter = loop.create_future()
+        entry = (loop, waiter)
+        with self._lock:
+            if self._generation != generation:
+                return
+            self._waiters.add(entry)
+        try:
+            async with asyncio.timeout(timeout):
+                await asyncio.shield(waiter)
+        except TimeoutError:
+            pass
+        finally:
+            with self._lock:
+                self._waiters.discard(entry)
+            if not waiter.done():
+                waiter.cancel()
+
+
+RUN_QUEUE_SIGNAL = RunQueueSignal()
